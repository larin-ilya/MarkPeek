#include "resource.h"

IDI_ICON1 ICON "../assets/icon.ico"

1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MarkPeek Project"
      VALUE "FileDescription", "MarkPeek - Typora-style Markdown viewer & editor"
      VALUE "FileVersion", "1.2.0"
      VALUE "InternalName", "MarkPeek"
      VALUE "OriginalFilename", "MarkPeek.exe"
      VALUE "ProductName", "MarkPeek"
      VALUE "ProductVersion", "1.2.0"
      VALUE "LegalCopyright", "Copyright (c) 2026 MarkPeek contributors. MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
